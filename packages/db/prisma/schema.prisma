// Receipt maker — data model.
//
// Every user-owned row carries `userId` and every query filters on it; that
// scoping is the whole of the multi-tenancy story. Ordered children carry an
// explicit `position` because the editors let the user reorder rows and the
// printed sheet must match what they arranged.
//
// Money is Decimal(12,2) and weights Decimal(10,3) so nothing drifts in
// storage. The application layer maps them to `number` at the boundary —
// see src/mappers.ts — because every derived amount snaps to a multiple of
// five anyway, and the calculation core is plain arithmetic.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"

  // The generated client is TypeScript source consumed straight by Turbopack.
  // Extensionless imports are what a bundler resolves; the default ".js"
  // specifiers point at files that do not exist on disk.
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension  = ""
}

// Prisma 7 keeps connection URLs out of the schema: migrations read them from
// prisma.config.ts, and the client gets a driver adapter at construction.
datasource db {
  provider = "postgresql"
}

// ─── Accounts ──────────────────────────────────────────────────────────────
// There is no public signup. An admin creates every account, so `username` is
// whatever the admin picked rather than a verified email.

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // stored lowercased
  passwordHash String
  displayName  String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  settings    Settings?
  clients     Client[]
  products    Product[]
  receipts    Receipt[]
  ledgers     Ledger[]
  priceLists  PriceList[]
  manReceipts ManReceipt[]
  catalog     CatalogItem[]
  counters    Counter[]
}

// Opaque session ids in an httpOnly cookie, rather than a signed token, so an
// admin can revoke a device by deleting the row.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Settings ──────────────────────────────────────────────────────────────

model Settings {
  id           String  @id @default(cuid())
  userId       String  @unique
  companyName  String  @default("")
  logoUrl      String? // Vercel Blob URL, not a data: URI
  primaryColor String  @default("#1f2937")
  accentColor  String  @default("#7c3aed")

  // Which optional columns each printed template shows, and how the auction
  // sheet flows into columns. Free-form because they are pure presentation and
  // change more often than the schema should.
  receiptColumns  Json @default("{\"sign\":true,\"count\":true,\"unitWeight\":true,\"totalWeight\":true}")
  ledgerColumns   Json @default("{\"invoice\":true,\"commission\":true,\"cash\":true,\"balance\":true,\"date\":true}")
  priceListConfig Json @default("{\"itemsPerColumn\":30,\"maxColumns\":3}")

  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Reference data ────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts Receipt[]

  @@index([userId, createdAt])
}

model Product {
  id         String   @id @default(cuid())
  userId     String
  name       String
  colorName  String
  colorHex   String
  unitWeight Decimal  @db.Decimal(10, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── فیش — the product receipt (no money on this one) ──────────────────────

model Receipt {
  id         String   @id @default(cuid())
  userId     String
  number     Int
  clientId   String?
  clientName String? // kept alongside the relation so a deleted client
  //                    doesn't blank out an already-printed receipt
  date       String // ISO yyyy-mm-dd, printed as-is; never a timestamp
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items  ReceiptItem[]

  @@unique([userId, number])
  @@index([userId, createdAt])
}

// Product details are denormalised onto the line: editing or deleting a product
// must never change what an already-issued receipt says.
model ReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  position    Int
  productId   String?
  productName String
  colorName   String
  colorHex    String
  unitWeight  Decimal @db.Decimal(10, 3)
  quantity    Int
  weight      Decimal @db.Decimal(10, 3)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId, position])
}

// ─── حساب — the account sheet ──────────────────────────────────────────────

model Ledger {
  id        String   @id @default(cuid())
  userId    String
  number    Int
  title     String
  date      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows LedgerRow[]

  @@unique([userId, number])
  @@index([userId, createdAt])
}

model LedgerRow {
  id         String  @id @default(cuid())
  ledgerId   String
  position   Int
  name       String
  date       String? // per-row date, optional
  invoice    Decimal @db.Decimal(12, 2) // فاکتور (debit)
  commission Decimal @db.Decimal(12, 2) // حق (debit)
  cash       Decimal @db.Decimal(12, 2) // صرافي (credit)

  ledger Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId, position])
}

// ─── فیش مزاد — the auction sheet ──────────────────────────────────────────

model PriceList {
  id                 String   @id @default(cuid())
  userId             String
  number             Int
  title              String
  date               String
  basketCount        Int? // تعداد باسکت
  commission         Decimal? @db.Decimal(12, 2) // حق
  commissionIsPercent Boolean @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    PriceListItem[]
  expenses PriceListExpense[]

  @@unique([userId, number])
  @@index([userId, createdAt])
}

model PriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  position    Int
  name        String
  price       Decimal @db.Decimal(12, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([priceListId, position])
}

// هزینه — one itemised cost line (برف, حمالی, …), deducted from the subtotal.
model PriceListExpense {
  id          String  @id @default(cuid())
  priceListId String
  position    Int
  label       String
  amount      Decimal @db.Decimal(12, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([priceListId, position])
}

// ─── فیش من — the same sheet, priced by weight ─────────────────────────────

model ManReceipt {
  id                 String   @id @default(cuid())
  userId             String
  number             Int
  title              String
  date               String
  basketCount        Int?
  commission         Decimal? @db.Decimal(12, 2)
  commissionIsPercent Boolean @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    ManReceiptItem[]
  expenses ManReceiptExpense[]

  @@unique([userId, number])
  @@index([userId, createdAt])
}

model ManReceiptItem {
  id           String  @id @default(cuid())
  manReceiptId String
  position     Int
  name         String
  weight       Decimal @db.Decimal(10, 3) // kg
  pricePerMan  Decimal @db.Decimal(12, 2) // rate per من (4 kg), not per kg

  manReceipt ManReceipt @relation(fields: [manReceiptId], references: [id], onDelete: Cascade)

  @@index([manReceiptId, position])
}

model ManReceiptExpense {
  id           String  @id @default(cuid())
  manReceiptId String
  position     Int
  label        String
  amount       Decimal @db.Decimal(12, 2)

  manReceipt ManReceipt @relation(fields: [manReceiptId], references: [id], onDelete: Cascade)

  @@index([manReceiptId, position])
}

// ─── Autocomplete catalogs ─────────────────────────────────────────────────
// Two catalogs, one table. They must not mix: the auction catalog remembers a
// line price, the من catalog a per-من rate, and cross-filling them would
// autofill wildly wrong numbers.

enum CatalogKind {
  PRICE
  MAN
}

model CatalogItem {
  id        String      @id @default(cuid())
  userId    String
  kind      CatalogKind
  name      String
  // Trimmed, whitespace-collapsed, lowercased. The unique index below is what
  // actually enforces de-duplication, rather than trusting the app to do it.
  nameKey   String
  price     Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, nameKey])
  @@index([userId, kind, createdAt])
}

// ─── Document numbering ────────────────────────────────────────────────────
// Each document type numbers from 1000 upward, per user. Held in a row and
// incremented inside the create transaction, which stays correct when two
// tabs save at once — `max(number) + 1` does not.

enum CounterKind {
  RECEIPT
  LEDGER
  PRICE_LIST
  MAN_RECEIPT
}

model Counter {
  id     String      @id @default(cuid())
  userId String
  kind   CounterKind
  value  Int         @default(1000)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}
